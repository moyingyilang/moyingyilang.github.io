---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getDocMenuTree } from '../utils/getMenuTree';

// 🔥 自动读取文件夹生成多级菜单
const menuTree = await getDocMenuTree();
---

<!-- 顶部导航：左侧汉堡 + 右侧标题 -->
<header class="navbar">
  <div class="navbar-content">
    <!-- 原版汉堡按钮（动画1:1保留） -->
    <button class="menu-toggle" id="menuToggle" aria-label="菜单开关">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <!-- 标题（不硬编码） -->
    <a href="/" class="logo">{SITE_TITLE}</a>
  </div>
</header>

<!-- 自动生成多级侧边栏菜单 -->
<aside class="sidebar" id="sidebar">
  <nav class="sidebar-nav">
    <!-- 递归渲染多级菜单 -->
    {menuTree.map((item) => (
      <Fragment>
        {item.children ? (
          <!-- 有子菜单：折叠父菜单 -->
          <li class="has-submenu">
            <a href="#">{item.label}</a>
            <ul class="submenu">
              {item.children.map((child) => (
                <Fragment>
                  {child.children ? (
                    <!-- 二级菜单 -->
                    <li class="has-submenu">
                      <a href="#">{child.label}</a>
                      <ul class="submenu">
                        {child.children.map((sub) => (
                          <li><HeaderLink href={sub.href}>{sub.label}</HeaderLink></li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li><HeaderLink href={child.href}>{child.label}</HeaderLink></li>
                  )}
                </Fragment>
              ))}
            </ul>
          </li>
        ) : (
          <!-- 无子女：直接链接 -->
          <li><HeaderLink href={item.href}>{item.label}</HeaderLink></li>
        )}
      </Fragment>
    ))}
  </nav>
</aside>

<script>
// 原版汉堡动画 + 菜单折叠交互
document.addEventListener('DOMContentLoaded', () => {
  const menuToggle = document.getElementById('menuToggle');
  const sidebar = document.getElementById('sidebar');
  const submenuToggles = document.querySelectorAll('.has-submenu > a');

  // 汉堡切换
  menuToggle.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    sidebar.classList.toggle('active');
  });

  // 多级菜单折叠
  submenuToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      toggle.parentElement.classList.toggle('active');
    });
  });
});
</script>

<style>
/* 完全保留你原来的样式 + 适配自动菜单 */
.navbar {
  background: #2c3e50;
  padding: 1rem 1.5rem;
  position: sticky;
  top: 0;
  z-index: 1000;
}
.navbar-content {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.logo {
  color: white;
  font-size: 1.5rem;
  text-decoration: none;
}

/* 原版汉堡动画（100%保留） */
.menu-toggle {
  background: none;
  border: none;
  cursor: pointer;
  width: 32px;
  height: 32px;
  position: relative;
}
.menu-toggle span {
  position: absolute;
  height: 2px;
  width: 24px;
  background: white;
  left: 50%;
  transform: translateX(-50%);
  transition: all 0.3s;
}
.menu-toggle span:nth-child(1) { top: 10px; }
.menu-toggle span:nth-child(2) { top: 16px; }
.menu-toggle span:nth-child(3) { top: 22px; }
.menu-toggle.active span:nth-child(1) {
  transform: translate(-50%, 6px) rotate(45deg);
}
.menu-toggle.active span:nth-child(2) { opacity: 0; }
.menu-toggle.active span:nth-child(3) {
  transform: translate(-50%, -6px) rotate(-45deg);
}

/* 侧边栏 + 多级菜单样式 */
.sidebar {
  position: fixed;
  top: 65px;
  left: 0;
  width: 280px;
  height: calc(100vh - 65px);
  background: #f8f9fa;
  border-right: 1px solid #eee;
  padding: 1.5rem;
  transform: translateX(-100%);
  transition: transform 0.3s;
  z-index: 999;
}
.sidebar.active { transform: translateX(0); }
.sidebar-nav { list-style: none; padding: 0; margin: 0; }
.sidebar-nav li { margin: 0.6rem 0; }
.sidebar-nav a {
  color: #2c3e50;
  text-decoration: none;
  padding: 0.5rem;
  display: block;
  border-radius: 4px;
}
.has-submenu > a::after {
  content: "▸";
  float: right;
  transition: transform 0.3s;
}
.has-submenu.active > a::after { transform: rotate(90deg); }
.submenu {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s;
  padding-left: 1rem;
}
.has-submenu.active .submenu { max-height: 500px; }

/* 移动端适配 */
@media (min-width: 992px) {
  .sidebar { transform: translateX(0); }
  .menu-toggle { display: none; }
}
</style>
