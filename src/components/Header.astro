---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { MENU_DATA } from '../config/menu.js';
---

<header class="navbar">
  <div class="navbar-content">
    <button class="menu-toggle" id="menuToggle" aria-label="菜单开关">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <a href="/" class="logo">{SITE_TITLE}</a>
  </div>
</header>

<aside class="sidebar" id="sidebar">
  <nav class="sidebar-nav">
    {MENU_DATA.map((item) => (
      <li class={item.children ? 'has-submenu' : ''}>
        {item.children
          ? <a href="#">{item.label}</a>
          : <HeaderLink href={`/${item.path}`}>{item.label}</HeaderLink>
        }
        {item.children && (
          <ul class="submenu">
            {item.children.map((child) => (
              <li class={child.children ? 'has-submenu' : ''}>
                {child.children
                  ? <a href="#">{child.label}</a>
                  : <HeaderLink href={`/${item.path}/${child.path}`}>{child.label}</HeaderLink>
                }
                {child.children && (
                  <ul class="submenu">
                    {child.children.map((sub) => (
                      <li>
                        <HeaderLink href={`/${item.path}/${child.path}/${sub.path}`}>{sub.label}</HeaderLink>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </nav>
</aside>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const menuToggle = document.getElementById('menuToggle');
  const sidebar = document.getElementById('sidebar');
  const submenuToggles = document.querySelectorAll('.has-submenu > a');

  menuToggle.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    sidebar.classList.toggle('active');
  });

  submenuToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      toggle.parentElement.classList.toggle('active');
    });
  });
});
</script>

<style>
.navbar {
  background: #2c3e50;
  padding: 1rem 1.5rem;
  position: sticky;
  top: 0;
  z-index: 1000;
}
.navbar-content {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.logo {
  color: white;
  font-size: 1.5rem;
  text-decoration: none;
}
.menu-toggle {
  background: none;
  border: none;
  cursor: pointer;
  width: 32px;
  height: 32px;
  position: relative;
}
.menu-toggle span {
  position: absolute;
  height: 2px;
  width: 24px;
  background: white;
  left: 50%;
  transform: translateX(-50%);
  transition: all 0.3s;
}
.menu-toggle span:nth-child(1) { top: 10px; }
.menu-toggle span:nth-child(2) { top: 16px; }
.menu-toggle span:nth-child(3) { top: 22px; }
.menu-toggle.active span:nth-child(1) { transform: translate(-50%, 6px) rotate(45deg); }
.menu-toggle.active span:nth-child(2) { opacity: 0; }
.menu-toggle.active span:nth-child(3) { transform: translate(-50%, -6px) rotate(-45deg); }
.sidebar {
  position: fixed;
  top: 65px;
  left: 0;
  width: 280px;
  height: calc(100vh - 65px);
  background: #f8f9fa;
  border-right: 1px solid #eee;
  padding: 1.5rem;
  transform: translateX(-100%);
  transition: transform 0.3s;
  z-index: 999;
}
.sidebar.active { transform: translateX(0); }
.sidebar-nav { list-style: none; padding: 0; margin: 0; }
.sidebar-nav li { margin: 0.6rem 0; }
.sidebar-nav a {
  color: #2c3e50;
  text-decoration: none;
  padding: 0.5rem;
  display: block;
  border-radius: 4px;
}
.has-submenu > a::after { content: "▸"; float: right; transition: transform 0.3s; }
.has-submenu.active > a::after { transform: rotate(90deg); }
.submenu { max-height: 0; overflow: hidden; transition: max-height 0.3s; padding-left: 1rem; }
.has-submenu.active .submenu { max-height: 500px; }
@media (min-width: 992px) {
  .sidebar { transform: translateX(0); }
  .menu-toggle { display: none; }
}
</style>
