---
import { SITE_TITLE } from '../consts';
import { findMenuTrail, normalizePath } from '../config/menu.js';
import ThemeToggle from './ThemeToggle.astro';

// 构建期就算好当前路径，静态托管下高亮才有效
const pathname = normalizePath(Astro.url.pathname);
const trail = findMenuTrail(pathname);
---

<header class="appbar">
	<div class="appbar__inner">
		<button
			type="button"
			class="btn btn--icon drawer-toggle"
			id="drawerToggle"
			aria-label="打开导航"
			aria-expanded="false"
			aria-controls="sidenav"
		>
			<svg
				class="drawer-toggle__open"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
			</svg>
			<svg
				class="drawer-toggle__close"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12"></path><path d="M18 6L6 18"></path>
			</svg>
		</button>

		<a href="/" class="appbar__brand">
			<span>{SITE_TITLE}</span>
		</a>

		{
			trail.length > 0 && (
				<nav class="appbar__crumbs" aria-label="面包屑">
					<a href="/">首页</a>
					{trail.map((node, i) => (
						<>
							<span class="sep" aria-hidden="true">/</span>
							{i === trail.length - 1 ? (
								<span aria-current="page">{node.label}</span>
							) : (
								<a href={node.href}>{node.label}</a>
							)}
						</>
					))}
				</nav>
			)
		}

		<div class="appbar__spacer"></div>

		<button type="button" class="btn search-btn" id="searchOpen" aria-label="搜索文档" aria-haspopup="dialog">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
				<circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" />
			</svg>
			<span class="search-btn__label">搜索</span>
			<kbd class="search-btn__kbd" data-search-kbd>Ctrl K</kbd>
		</button>

		<button
			type="button"
			class="btn btn--icon"
			id="settingsOpen"
			aria-label="壁纸与外观设置"
			title="壁纸与外观设置"
			aria-haspopup="dialog"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="3.2"></circle>
				<path
					d="M19.1 14.6a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.55V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.24 15a1.7 1.7 0 0 0-1.55-1.03H2.6a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.24 8.9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 8.6 4.54h.08A1.7 1.7 0 0 0 9.71 3V2.9a2 2 0 1 1 4 0V3a1.7 1.7 0 0 0 1.03 1.54 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V9a1.7 1.7 0 0 0 1.55 1.03h.1a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.55 1.03z"
				></path>
			</svg>
		</button>

		<ThemeToggle />
	</div>
</header>

<style>
	.search-btn {
		border-radius: var(--r-pill);
		padding: 0.4rem 0.75rem 0.4rem 0.6rem;
		color: var(--text-secondary);
	}

	.search-btn svg {
		width: 16px;
		height: 16px;
		flex: none;
	}

	.search-btn__label {
		font-size: 0.85rem;
	}

	.search-btn__kbd {
		font-size: 0.68rem;
		color: var(--text-tertiary);
	}

	/* 抽屉开关在开合之间切换图标 */
	.drawer-toggle__close {
		display: none;
	}

	:global(body.is-drawer-open) .drawer-toggle__open {
		display: none;
	}

	:global(body.is-drawer-open) .drawer-toggle__close {
		display: block;
	}
</style>
