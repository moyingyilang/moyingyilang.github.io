---
import { LICENSE, REPO_URL, SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();

/*
 * 图标按 consts.ts 里 SOCIAL_LINKS 的 `icon` 字段匹配 ——
 * 用显式 id 而不是 label，改显示名不会把图标弄丢。
 * 保留原始 SVG（含各自不同的 viewBox 与描边方式），因此整段注入。
 */
const ICONS = {
	github: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.29-.88.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>`,
	bilibili: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.223 3.086a1.25 1.25 0 0 1 0 1.768L17.08 5.996h1.17A3.75 3.75 0 0 1 22 9.747v7.5a3.75 3.75 0 0 1-3.75 3.75H5.75A3.75 3.75 0 0 1 2 17.247v-7.5a3.75 3.75 0 0 1 3.75-3.75h1.166L5.775 4.855a1.25 1.25 0 1 1 1.767-1.768l2.652 2.652c.079.079.145.165.198.257h3.213c.053-.092.12-.18.199-.258l2.651-2.652a1.25 1.25 0 0 1 1.768 0zm.027 5.42H5.75a1.25 1.25 0 0 0-1.247 1.157l-.003.094v7.5c0 .659.51 1.199 1.157 1.246l.093.004h12.5a1.25 1.25 0 0 0 1.247-1.157l.003-.093v-7.5c0-.69-.56-1.25-1.25-1.25zm-10 2.5c.69 0 1.25.56 1.25 1.25v1.25a1.25 1.25 0 1 1-2.5 0v-1.25c0-.69.56-1.25 1.25-1.25zm7.5 0c.69 0 1.25.56 1.25 1.25v1.25a1.25 1.25 0 1 1-2.5 0v-1.25c0-.69.56-1.25 1.25-1.25z"/></svg>`,
	coolapk: `<svg viewBox="0 0 192 192" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="12" aria-hidden="true"><path d="M99.07 78.038s-5.118-3.89-14.431-9.826c-8.086-5.117-15.967-8.495-26.714-8.495C31.723 59.717 22 78.755 22 94.926c0 28.454 22.722 36.437 37.256 36.437 37.256 0 65.812-67.961 70.111-72.363L170 133.103l-44.215-33.571"/></svg>`,
};

const links = SOCIAL_LINKS.map((link) => ({ ...link, svg: ICONS[link.icon] ?? '' }));
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__text">
			{/*
				注意：不要在采用 AGPL 之后再写「保留所有权利」——
				那与许可证授予的权利相矛盾。
			*/}
			<p class="site-footer__copy">
				&copy; {year} {SITE_AUTHOR} · 代码以
				<a href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">
					{LICENSE.shortName}
				</a>
				授权
			</p>
			<p class="site-footer__meta">
				基于 Astro 构建 · Fluent × MIUI 玻璃视觉 · <a href="/about">视觉与工程由 AI 协作完成</a>
			</p>
		</div>
		<div class="site-footer__icons">
			{
				links.map((link) =>
					link.svg ? (
						<a
							class="icon-btn"
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={link.label}
							title={link.label}
							set:html={link.svg}
						/>
					) : (
						// 没有对应图标时回退为文字，避免新增链接被静默丢弃
						<a
							class="icon-btn icon-btn--text"
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.label}
						</a>
					),
				)
			}
		</div>
	</div>
</footer>

<style>
	.site-footer__text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.site-footer__copy {
		margin: 0;
	}

	.icon-btn--text {
		width: auto;
		padding: 0 0.7rem;
		font-size: 0.78rem;
		white-space: nowrap;
	}

	.site-footer__copy a,
	.site-footer__meta a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		text-underline-offset: 3px;
	}

	.site-footer__copy a:hover,
	.site-footer__meta a:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.site-footer__meta {
		margin: 0;
		font-size: 0.76rem;
		color: var(--text-tertiary);
		opacity: 0.85;
	}
</style>
