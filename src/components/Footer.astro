<style>
  .site-footer {
    padding: 2.5rem 1rem 3.5rem;
    background: #1a1b2e;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-copyright {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .footer-icons {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
  }
  .footer-icon {
    color: rgba(255, 255, 255, 0.85);
    transition: all 0.22s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .footer-icon:hover {
    color: #fff;
    transform: translateY(-2px);
  }
  .footer-icon svg {
    width: 28px;
    height: 28px;
  }
</style>
