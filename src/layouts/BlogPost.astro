---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';

const { frontmatter = {}, headings = [], Content = null } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title={frontmatter?.title || '页面'} />
</head>
<body>
  <Header />
  <div class="post-container">
    <nav class="toc">
      <h4>目录</h4>
      <ul>
        {headings.map(h => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>

    <article class="post-content">
      <h1>{frontmatter?.title || '无标题'}</h1>
      <div class="date">{frontmatter?.date || ''}</div>
      <!-- 直接渲染Content，修复核心报错 -->
      {Content && <Content />}
      
      <div class="post-nav">
        {frontmatter?.prev && (
          <a href={`/${frontmatter.prev}`}>上一篇</a>
        )}
        {frontmatter?.next && (
          <a href={`/${frontmatter.next}`}>下一篇</a>
        )}
      </div>
    </article>
  </div>
  <Footer />
</body>
</html>

<style>
.post-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
  display: flex;
  gap: 2rem;
}
.toc {
  min-width: 220px;
  position: sticky;
  top: 2rem;
  align-self: flex-start;
}
.toc ul {
  list-style: none;
  padding: 0;
}
.toc li {
  margin: 0.5rem 0;
}
.toc a {
  color: inherit;
  text-decoration: none;
}
.post-content {
  flex: 1;
  max-width: 800px;
}
.date {
  color: #888;
  margin: 0.5rem 0 2rem;
}
.post-nav {
  margin-top: 3rem;
  display: flex;
  gap: 1rem;
}
.post-nav a {
  padding: 0.7rem 1rem;
  background: rgba(255,255,255,.05);
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
}
img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  loading: lazy;
}
</style>
