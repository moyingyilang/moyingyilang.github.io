---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	categoryOf,
	formatDate,
	getSortedPosts,
	postHref,
	readingTime,
	relatedPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			// 列表按日期倒序，因此上一项是更新的文章
			prev: posts[index + 1] ?? null,
			next: posts[index - 1] ?? null,
		},
	}));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const cat = categoryOf(post);
const date = post.data.date ?? post.data.pubDate;
const tags = post.data.tags ?? [];

// 同分类或共同标签的文章：本站是文档站，横向跳转比时间线更有用
const related = relatedPosts(post, await getSortedPosts(), 3);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	headings={headings}
	type="article"
>
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		<span class="sep" aria-hidden="true">/</span>
		<a href="/blog">文章列表</a>
		<span class="sep" aria-hidden="true">/</span>
		{
			cat && (
				<>
					<a href={cat.href}>{cat.label}</a>
					<span class="sep" aria-hidden="true">/</span>
				</>
			)
		}
		<span aria-current="page">{post.data.title}</span>
	</nav>

	<article class="card card--pad">
		<header class="post-header">
			<h1 class="page-title">{post.data.title}</h1>
			{post.data.description && <p class="page-desc">{post.data.description}</p>}

			<div class="card__meta post-meta">
				{cat && <a class="badge" href={cat.href}>{cat.label}</a>}
				<span>{formatDate(date)}</span>
				<span>· {readingTime(post.body)}</span>
				{post.data.updatedDate && <span>· 更新于 {formatDate(post.data.updatedDate)}</span>}
			</div>

			{
				tags.length > 0 && (
					<div class="row post-tags">
						{tags.map((tag) => (
							<span class="badge badge--muted">{tag}</span>
						))}
					</div>
				)
			}
		</header>

		<div class="prose">
			<Content />
		</div>
	</article>

	{
		(prev || next) && (
			<nav class="post-nav" aria-label="相邻文章">
				{prev && (
					<a class="card post-nav__item" href={postHref(prev)}>
						<span class="post-nav__label">← 上一篇</span>
						<span class="post-nav__title">{prev.data.title}</span>
					</a>
				)}
				{next && (
					<a class="card post-nav__item post-nav__item--end" href={postHref(next)}>
						<span class="post-nav__label">下一篇 →</span>
						<span class="post-nav__title">{next.data.title}</span>
					</a>
				)}
			</nav>
		)
	}

	{
		related.length > 0 && (
			<section class="related">
				<h2 class="section-heading">相关文章</h2>
				<div class="grid grid--auto">
					{related.map((item) => (
						<a class="card reveal" href={postHref(item)}>
							<span class="card__arrow">→</span>
							<h3 class="card__title">{item.data.title}</h3>
							{item.data.description && <p class="card__desc">{item.data.description}</p>}
						</a>
					))}
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 1.8rem;
		padding-bottom: 1.4rem;
		border-bottom: 1px solid var(--stroke);
	}

	.post-meta {
		margin-top: 0.9rem;
	}

	.post-meta .badge:hover {
		text-decoration: none;
	}

	.post-tags {
		margin-top: 0.6rem;
	}

	.post-nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.post-nav__item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.post-nav__item--end {
		text-align: right;
	}

	.post-nav__label {
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		color: var(--text-tertiary);
	}

	.post-nav__title {
		font-weight: 550;
		color: var(--text);
	}

	.related {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
</style>
