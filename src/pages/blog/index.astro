---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryOf, formatDate, getSortedPosts, postHref, readingTime } from '../../utils/posts';

const posts = await getSortedPosts();
const tagCount = new Set(posts.flatMap((post) => post.data.tags ?? [])).size;
---

<BaseLayout title="文章列表" description="全部文章按发布时间倒序归档。">
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		<span class="sep" aria-hidden="true">/</span>
		<span aria-current="page">文章列表</span>
	</nav>

	<div class="page-head">
		<h1 class="page-title">文章列表</h1>
		<p class="page-desc">
			共 {posts.length} 篇文章、{tagCount} 个标签，按发布时间倒序排列。
		</p>
	</div>

	{
		posts.length > 0 ? (
			<div class="stack">
				{posts.map((post, index) => {
					const cat = categoryOf(post);
					return (
						<a
							class="card reveal"
							href={postHref(post)}
							style={`transition-delay:${Math.min(index * 40, 200)}ms`}
						>
							<span class="card__arrow">→</span>
							<h2 class="card__title">{post.data.title}</h2>
							{post.data.description && <p class="card__desc">{post.data.description}</p>}
							<p class="card__meta">
								{cat && <span class="badge">{cat.label}</span>}
								<span>{formatDate(post.data.date ?? post.data.pubDate)}</span>
								<span>· {readingTime(post.body)}</span>
								{(post.data.tags ?? []).map((tag) => (
									<span class="badge badge--muted">{tag}</span>
								))}
							</p>
						</a>
					);
				})}
			</div>
		) : (
			<div class="empty-state">
				<p class="empty-state__icon" aria-hidden="true">📄</p>
				<p>还没有文章，往 <code>src/content/blog/</code> 里添加第一个 <code>.mdx</code> 吧。</p>
			</div>
		)
	}
</BaseLayout>
