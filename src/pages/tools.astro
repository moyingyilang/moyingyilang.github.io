---

<BaseLayout
	title="杂项工具"
	description="本站的检索、订阅与索引入口，以及长期在用的 Android 工具与应用清单。"
>
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		<span class="sep" aria-hidden="true">/</span>
		<span aria-current="page">杂项工具</span>
	</nav>

	<div class="page-head">
		<span class="page-head__eyebrow badge">独立页面</span>
		<h1 class="page-title">杂项工具</h1>
		<p class="page-desc">
			本站的检索、订阅与外观设置入口（{siteTotal} 项），以及长期在用的软件清单（{total} 项，均给出可获取的出处）。
		</p>
	</div>

	<section class="tool-section">
		<h2 class="section-heading">站内入口</h2>

		{
			SITE_GROUPS.map((group) => (
				<div class="tool-group">
					<h3 class="tool-group__head glass">
						{group.label}
						<span class="tool-group__count">{group.items.length}</span>
					</h3>
					<div class="grid grid--2">
						{group.items.map((item) => (
							<a
								class="card reveal"
								href={item.href}
								data-site-action={item.action ?? undefined}
							>
								<span class="card__arrow">→</span>
								<div class="tool__head">
									<h4 class="card__title">{item.title}</h4>
									<span class="badge badge--muted">{item.badge}</span>
								</div>
								<p class="card__desc">{item.desc}</p>
							</a>
						))}
					</div>
				</div>
			))
		}
	</section>

	<section class="tool-section">
		<h2 class="section-heading">常用软件</h2>
		<p class="tool-note">
			全部为自用，按用途分组。点进去都是官方仓库或官网，不经过第三方下载站。
		</p>

		{
			APP_GROUPS.map((group) => (
				<div class="tool-group">
					<h3 class="tool-group__head glass">
						{group.label}
						<span class="tool-group__count">{group.items.length}</span>
					</h3>
					<div class="grid grid--auto">
						{group.items.map((item) => (
							<a
								class="card reveal"
								href={item.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="card__arrow">↗</span>
								<div class="tool__head">
									<h4 class="card__title">{item.title}</h4>
									<span class="badge badge--muted">{item.badge}</span>
								</div>
								<p class="card__desc">{item.desc}</p>
							</a>
						))}
					</div>
				</div>
			))
		}
	</section>
</BaseLayout>

<script>
	/*
	 * 带 data-site-action 的卡片不跳转，而是点击页面上已有的控件。
	 * 复用顶栏那几个按钮，避免入口卡片和顶栏出现两套行为。
	 */
	const SITE_ACTIONS = {
		search: 'searchOpen',
		settings: 'settingsOpen',
		theme: 'themeToggle',
		shuffle: 'wallpaperShuffle',
	};

	for (const card of document.querySelectorAll('[data-site-action]')) {
		const targetId = SITE_ACTIONS[card.dataset.siteAction];
		if (!targetId) continue;
		card.addEventListener('click', (event) => {
			event.preventDefault();
			document.getElementById(targetId)?.click();
		});
	}
</script>

