---
import BaseLayout from '../layouts/BaseLayout.astro';

/** 站内提供的入口 */
const SITE_TOOLS = [
	{
		title: '站内搜索',
		desc: '按标题、描述与分类检索全站内容，支持键盘操作。',
		href: '#',
		action: 'search',
		badge: 'Ctrl + K',
	},
	{
		title: 'RSS 订阅',
		desc: '用任意阅读器订阅本站更新，只包含正式发布的文章。',
		href: '/rss.xml',
		badge: 'XML',
	},
	{
		title: '站点地图',
		desc: '提交给搜索引擎的全站 URL 索引，构建时自动生成。',
		href: '/sitemap-index.xml',
		badge: 'XML',
	},
	{
		title: '文章归档',
		desc: '按分类归集浏览全部文章，带标签与阅读时长标注。',
		href: '/blog',
		badge: '列表',
	},
];

/**
 * 自用软件清单。
 *
 * 收录标准：能给出**可验证的获取地址**（官网 / GitHub / F-Droid / 商店），
 * 且确实长期在用。只罗列包名对读者没有意义，所以一律给出处。
 */
const APP_GROUPS = [
	{
		label: '终端与逆向',
		items: [
			{
				title: 'Termux',
				desc: '无需 root 的终端环境，可直接在手机上跑 Python、GCC、git、radare2。本站在手机上做的逆向分析都在它里面完成。',
				href: 'https://github.com/termux/termux-app',
				badge: 'GitHub',
			},
			{
				title: 'Termux:API',
				desc: '让 Termux 脚本调用手机硬件：剪贴板、短信、传感器、GPS、通知。写自动化脚本时的必备扩展。',
				href: 'https://github.com/termux/termux-api',
				badge: 'GitHub',
			},
			{
				title: 'Termux:Boot',
				desc: '开机自动执行 Termux 脚本。需要长期驻留的自动化任务靠它拉起。',
				href: 'https://github.com/termux/termux-boot',
				badge: 'GitHub',
			},
			{
				title: 'MT 管理器',
				desc: 'APK 编辑、DEX 反编译、资源替换、文本十六进制编辑。国内 Android 折腾的常用工具，另有 MT 终端扩展包。',
				href: 'https://mt2.cn/',
				badge: '官网',
			},
			{
				title: 'Apktool M',
				desc: '界面化的 APK 反编译与重打包，比命令行 apktool 省事，适合快速改包验证。',
				href: 'https://maximoff.su/apktool/',
				badge: '官网',
			},
			{
				title: 'HttpCanary',
				desc: 'HTTP／HTTPS 抓包工具，配合证书可看明文请求。⚠️ 官方自 2021 年起停止维护，新系统上可能无法正常工作。',
				href: 'https://github.com/MegatronKing/HttpCanary',
				badge: 'GitHub',
			},
		],
	},
	{
		label: 'Root 与系统工具',
		items: [
			{
				title: 'KernelSU',
				desc: '基于内核的 root 方案，权限管理在内核态完成，比传统方案更难被应用探测到。',
				href: 'https://github.com/tiann/KernelSU',
				badge: 'GitHub',
			},
			{
				title: 'Shizuku',
				desc: '免 root 提权：通过 ADB 授权，让普通应用也能调用系统级 API。很多现代工具依赖它。',
				href: 'https://github.com/RikkaApps/Shizuku',
				badge: 'GitHub',
			},
			{
				title: 'Scene',
				desc: '性能调度、温控与功耗监控。可以查看频率曲线、调整调度策略。',
				href: 'https://github.com/helloklf/vtools',
				badge: 'GitHub',
			},
			{
				title: 'Hail',
				desc: '冻结／解冻应用，替代「冰箱」类工具。冻结后应用不占内存也不后台跑。',
				href: 'https://github.com/aistra0528/Hail',
				badge: 'GitHub',
			},
			{
				title: 'DataBackup',
				desc: '应用数据备份与恢复，支持 root 方式完整备份，换机时很有用。',
				href: 'https://github.com/XayahSuSuSu/Android-DataBackup',
				badge: 'GitHub',
			},
			{
				title: 'Disky',
				desc: '磁盘占用分析，按目录逐层展开找出最占空间的「小偷」。',
				href: 'https://f-droid.org/packages/de.felixnuesse.disky/',
				badge: 'F-Droid',
			},
			{
				title: 'DriveDroid',
				desc: '把手机当 U 盘或启动盘用，可挂载 ISO 给电脑启动系统。',
				href: 'https://softwarebakery.com/projects/drivedroid',
				badge: '官网',
			},
			{
				title: 'FuseFixer',
				desc: '修复 Android 11 以后 FUSE 存储重定向带来的权限问题，逆向取文件时常需要。',
				href: 'https://github.com/5ec1cff/FuseFixer',
				badge: 'GitHub',
			},
			{
				title: 'I-Am-Pad',
				desc: '让应用以为设备是大屏平板，用来开启应用的平板模式。',
