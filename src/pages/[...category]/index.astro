---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BaseHead from '../../components/BaseHead.astro';
import { MENU_DATA } from '../../config/menu.js';

export const prerender = true;

function getAllPaths(menu, parentPath = '') {
  let paths = [];
  for (const item of menu) {
    const fullPath = parentPath ? `${parentPath}/${item.path}` : item.path;
    paths.push(fullPath);
    if (item.children?.length) {
      paths = paths.concat(getAllPaths(item.children, fullPath));
    }
  }
  return paths;
}

export async function getStaticPaths() {
  const allPaths = getAllPaths(MENU_DATA);
  return allPaths.map(path => ({ params: { category: path } }));
}

const { category } = Astro.params;
const paths = category ? category.split('/').filter(Boolean) : [];

function findLabels(segments) {
  let currentList = MENU_DATA;
  const labels = [];
  for (const seg of segments) {
    const item = currentList.find(x => x.path === seg);
    if (item) {
      labels.push(item.label);
      currentList = item.children || [];
    } else break;
  }
  return labels;
}

const titleParts = findLabels(paths);
const pageTitle = titleParts.join(' · ') || '分类';
const currentCat = paths.at(-1);

const posts = Object.entries(import.meta.glob('../../pages/blog/*.mdx', { eager: true }))
  .map(([f, mod]) => ({
    slug: f.split('/').pop()?.replace(/\.mdx$/,''),
    ...mod.frontmatter
  }))
  .filter(p => p.category === currentCat);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead title={pageTitle} />
</head>
<body>
  <Header />
  <main style="max-width:900px; margin:0 auto; padding:3rem 1rem;">
    <h1 style="font-size:clamp(1.4rem, 4vw, 2rem); margin:0 0 2rem;">{pageTitle}</h1>
    {posts.length ? (
      <div style="margin-top:2rem; display:flex; flex-direction:column; gap:1.2rem;">
        {posts.map(post => (
          <a href={`/${post.slug}`} style="display:block; padding:1.2rem 1.5rem; border-radius:10px; background:rgba(255,255,255,0.04); text-decoration:none; color:inherit;">
            <h2 style="margin:0; font-size:1.25rem;">{post.title}</h2>
          </a>
        ))}
      </div>
    ) : (
      <div style="margin-top:4rem; text-align:left; font-size:1rem; color:#888;">该分类下暂无文章</div>
    )}
  </main>
  <Footer />
</body>
</html>
