---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	HIDE_EMPTY_CATEGORIES,
	MENU_DATA,
	categoryPaths,
	findMenuTrail,
	flattenMenu,
	normalizePath,
	pruneEmpty,
} from '../../config/menu.js';
import {
	categoryOf,
	formatDate,
	getSortedPosts,
	postHref,
	readingTime,
	usedCategories,
} from '../../utils/posts';
import { visibleMenuNodes } from '../../utils/nav';

export const prerender = true;

/**
 * 生成分类页路由。
 *
 * 两种情况必须排除：
 * 1. dedicated 节点（tools / faq / about）有自己的 .astro，
 *    一并生成会产出同一 URL 并在构建时冲突；
 * 2. 还没有文章的分类 —— 空页面既没有浏览价值，也会污染站点地图。
 *    写了文章后下次构建会自动出现。
 */
export async function getStaticPaths() {
	if (!HIDE_EMPTY_CATEGORIES) {
		return categoryPaths().map((category) => ({ params: { category } }));
	}

	const pruned = pruneEmpty(MENU_DATA, await usedCategories());
	const paths = flattenMenu(pruned)
		.filter((node) => !node.dedicated)
		.map((node) => node.href.replace(/^\//, ''));

	return paths.map((category) => ({ params: { category } }));
}

const pathname = normalizePath(Astro.url.pathname);
const trail = findMenuTrail(pathname);
// 用裁剪后的可见菜单：否则会列出没有任何文章的子分类，链到不存在的页面
const nodes = await visibleMenuNodes();
const self = nodes.find((node) => node.href === pathname) ?? null;

const children = self
	? nodes.filter((node) => node.depth === self.depth + 1 && node.href.startsWith(`${pathname}/`))
	: [];

const title = self?.label ?? trail.at(-1)?.label ?? '分类';
const segment = pathname.split('/').filter(Boolean).pop();

const posts = await getSortedPosts();
const matched = posts.filter((post) => post.data.category === segment);
---

<BaseLayout title={title} description={`${title} 分类下的全部文档与文章。`}>
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		{
			trail.map((node, index) => (
				<>
					<span class="sep" aria-hidden="true">/</span>
					{index === trail.length - 1 ? (
						<span aria-current="page">{node.label}</span>
					) : (
						<a href={node.href}>{node.label}</a>
					)}
				</>
			))
		}
	</nav>

	<div class="page-head">
		<span class="page-head__eyebrow badge">分类</span>
		<h1 class="page-title">{title}</h1>
		<p class="page-desc">
			{matched.length > 0 ? `该分类下有 ${matched.length} 篇文章。` : '该分类下暂无文章，以下是它的子分类。'}
		</p>
	</div>

	{
		children.length > 0 && (
			<section class="stack">
				<h2 class="section-heading">子分类</h2>
				<div class="grid grid--auto">
					{children.map((child, index) => {
						const count = posts.filter((post) => post.data.category === child.path).length;
						return (
							<a
								class="card reveal"
								href={child.href}
								style={`transition-delay:${Math.min(index * 40, 200)}ms`}
							>
								<span class="card__arrow">→</span>
								<h3 class="card__title">{child.label}</h3>
								<p class="card__meta">
									<span>{count > 0 ? `${count} 篇文章` : '暂无文章'}</span>
								</p>
							</a>
						);
					})}
				</div>
			</section>
		)
	}

	{
		matched.length > 0 ? (
			<section class="stack">
				<h2 class="section-heading">本分类文章</h2>
				<div class="stack">
					{matched.map((post, index) => {
						const cat = categoryOf(post);
						return (
							<a
								class="card reveal"
								href={postHref(post)}
								style={`transition-delay:${Math.min(index * 40, 200)}ms`}
							>
								<span class="card__arrow">→</span>
								<h3 class="card__title">{post.data.title}</h3>
								{post.data.description && <p class="card__desc">{post.data.description}</p>}
								<p class="card__meta">
									{cat && cat.href !== pathname && <span class="badge">{cat.label}</span>}
									<span>{formatDate(post.data.date ?? post.data.pubDate)}</span>
									<span>· {readingTime(post.body)}</span>
								</p>
							</a>
						);
					})}
				</div>
			</section>
		) : (
			children.length === 0 && (
				<div class="empty-state">
					<p class="empty-state__icon" aria-hidden="true">🗂️</p>
					<p>
						该分类下暂无文章。给文章的 frontmatter 加上
						<code>category: {segment}</code> 即可出现在这里。
					</p>
				</div>
			)
		)
	}
</BaseLayout>
