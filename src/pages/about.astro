---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	AI_CONTRIBUTION,
	LICENSE,
	REPO_URL,
	SITE_AUTHOR,
	SITE_COPYRIGHT_YEAR,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SOCIAL_LINKS,
} from '../consts';

const STACK = [
	{ label: '框架', value: 'Astro 6（静态输出）' },
	{ label: '内容', value: 'Content Collections + MDX' },
	{ label: '样式', value: '原生 CSS 设计令牌，无 UI 框架' },
	{ label: '视觉', value: 'Fluent Acrylic / Mica × MIUI 玻璃' },
	{ label: '交互', value: '浅色 / 深色切换、命令面板搜索' },
	{ label: '部署', value: 'GitHub Pages' },
];

const thisYear = new Date().getFullYear();
const copyrightYears =
	thisYear > SITE_COPYRIGHT_YEAR ? `${SITE_COPYRIGHT_YEAR}–${thisYear}` : String(SITE_COPYRIGHT_YEAR);
---

<BaseLayout title="关于" description={SITE_DESCRIPTION}>
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		<span class="sep" aria-hidden="true">/</span>
		<span aria-current="page">关于</span>
	</nav>

	<div class="page-head">
		<span class="page-head__eyebrow badge">独立页面</span>
		<h1 class="page-title">关于本站</h1>
		<p class="page-desc">{SITE_DESCRIPTION}</p>
	</div>

	<section class="card card--pad reveal">
		<div class="prose">
			<h2>这个站是做什么的</h2>
			<p>
				{SITE_TITLE} 是一个用来沉淀技术笔记与项目记录的个人文档站。内容以编程、系统优化、硬件与刷机实践为主，
				目标是「写得少一点，但每次都能查到」。
			</p>

			<h2>内容怎么组织</h2>
			<p>
				左侧导航就是目录树，分为科创、代码、小知识/随笔三个板块，外加杂项工具、常见问题、关于三个独立页面。
				每篇文章通过 frontmatter 的 <code>category</code> 归属到对应分类，分类页会自动汇总。
			</p>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">技术栈</h2>
		<div class="card card--pad reveal">
			<dl class="stack-list">
				{
					STACK.map((item) => (
						<div class="stack-list__row">
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">联系方式</h2>
		<div class="card card--pad reveal">
			<p class="page-desc contact__lead">欢迎交流，也可以在 GitHub 提 Issue。</p>
			<div class="row">
				{
					SOCIAL_LINKS.map((link) => (
						<a class="btn" href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					))
				}
				<a class="btn btn--ghost" href="/rss.xml">RSS 订阅</a>
			</div>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">许可与参与</h2>

		<div class="card card--pad reveal">
			<div class="prose">
				<h3>开源许可</h3>
				<p>
					本站代码以 <a href={LICENSE.url} target="_blank" rel="noopener noreferrer">{LICENSE.name}</a>
					（<code>{LICENSE.id}</code>）授权，完整条款见仓库根目录的 <code>{LICENSE.file}</code> 文件。
					这是常见开源许可里约束最强的一种：衍生作品必须同样以 AGPL 开放；
					第 13 条还明确规定，若把修改后的版本作为网络服务提供，必须向使用者提供对应源码。
				</p>
				<p>
					需要留意：许可证覆盖的是本站的<strong>代码与站主原创内容</strong>。
					壁纸功能以外链方式引用第三方图片（游戏素材、Bing 每日壁纸、二次元图源），
					这些图片的版权属于各自权利人，不在本站许可范围内，本站也没有再分发它们。
				</p>

				<h3>AI 参与声明</h3>
				<p>{AI_CONTRIBUTION.summary}</p>
				<ul>
					{AI_CONTRIBUTION.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<p class="muted">
					参与形式：{AI_CONTRIBUTION.assistant}（模型 {AI_CONTRIBUTION.model}），
					担任{AI_CONTRIBUTION.role}。{AI_CONTRIBUTION.disclaimer}
				</p>
			</div>
		</div>

		<div class="card reveal">
			<div class="row">
				<a class="btn" href={REPO_URL} target="_blank" rel="noopener noreferrer">查看源码仓库</a>
				<a class="btn btn--ghost" href={LICENSE.url} target="_blank" rel="noopener noreferrer">
					许可证全文
				</a>
			</div>
		</div>
	</section>

	<p class="muted about-foot">
		&copy; {copyrightYears} {SITE_AUTHOR} · 代码以 {LICENSE.shortName} 授权
	</p>
</BaseLayout>

<style>
	.stack-list {
		margin: 0;
		display: grid;
		gap: 0.1rem;
	}

	.stack-list__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--stroke);
	}

	.stack-list__row:last-child {
		border-bottom: none;
	}

	.stack-list__row dt {
		min-width: 5.5rem;
		font-size: 0.85rem;
		color: var(--text-tertiary);
	}

	.stack-list__row dd {
		margin: 0;
		flex: 1;
		min-width: 12rem;
		color: var(--text-secondary);
		font-size: 0.92rem;
	}

	.contact__lead {
		margin: 0 0 1rem;
		font-size: 0.94rem;
	}

	.about-foot {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
		text-align: center;
	}
</style>
