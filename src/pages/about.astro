---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	AI_CONTRIBUTION,
	LICENSE,
	REPO_URL,
	SITE_AUTHOR,
	SITE_COPYRIGHT_YEAR,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SOCIAL_LINKS,
} from '../consts';

const STACK = [
	{ label: '框架', value: 'Astro 6（静态输出）' },
	{ label: '内容', value: 'Content Collections + MDX' },
	{ label: '样式', value: '原生 CSS 设计令牌，无 UI 框架' },
	{ label: '视觉', value: 'Fluent Acrylic / Mica × MIUI 玻璃' },
	{ label: '交互', value: '浅色 / 深色切换、命令面板搜索' },
	{ label: '部署', value: 'GitHub Pages' },
];

const thisYear = new Date().getFullYear();
const copyrightYears =
	thisYear > SITE_COPYRIGHT_YEAR ? `${SITE_COPYRIGHT_YEAR}–${thisYear}` : String(SITE_COPYRIGHT_YEAR);
---

<BaseLayout title="关于" description={SITE_DESCRIPTION}>
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		<span class="sep" aria-hidden="true">/</span>
		<span aria-current="page">关于</span>
	</nav>

	<div class="page-head">
		<span class="page-head__eyebrow badge">独立页面</span>
		<h1 class="page-title">关于本站</h1>
		<p class="page-desc">{SITE_DESCRIPTION}</p>
	</div>

	<section class="card card--pad reveal">
		<div class="prose">
			<h2>这个站是做什么的</h2>
			<p>
				{SITE_TITLE} 是一个用来沉淀技术笔记与项目记录的个人文档站。内容以编程、系统优化、硬件与刷机实践为主，
				目标是「写得少一点，但每次都能查到」。
			</p>

			<h2>内容怎么组织</h2>
			<p>
				左侧导航就是目录树，分为科创、代码、小知识/随笔三个板块，外加杂项工具、常见问题、关于三个独立页面。
				每篇文章通过 frontmatter 的 <code>category</code> 归属到对应分类，分类页会自动汇总。
			</p>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">技术栈</h2>
		<div class="card card--pad reveal">
			<dl class="stack-list">
				{
					STACK.map((item) => (
						<div class="stack-list__row">
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">联系方式</h2>
		<div class="card card--pad reveal">
			<p class="page-desc contact__lead">欢迎交流，也可以在 GitHub 提 Issue。</p>
			<div class="row">
				{
					SOCIAL_LINKS.map((link) => (
						<a class="btn" href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					))
				}
				<a class="btn btn--ghost" href="/rss.xml">RSS 订阅</a>
			</div>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">许可与参与</h2>

		<div class="card card--pad reveal">
			<div class="prose">
				<h3>开源许可</h3>
				<p>
					本站代码以 <a href={LICENSE.url} target="_blank" rel="noopener noreferrer">{LICENSE.name}</a>
					（<code>{LICENSE.id}</code>）授权，完整条款见仓库根目录的 <code>{LICENSE.file}</code> 文件。
					这是常见开源许可里约束最强的一种：衍生作品必须同样以 AGPL 开放；
					第 13 条还明确规定，若把修改后的版本作为网络服务提供，必须向使用者提供对应源码。
				</p>
				<p>
					需要留意：许可证覆盖的是本站的<strong>代码与站主原创内容</strong>。
					壁纸功能以外链方式引用第三方图片（游戏素材、Bing 每日壁纸、二次元图源），
					这些图片的版权属于各自权利人，不在本站许可范围内，本站也没有再分发它们。
				</p>

				<h3>AI 参与声明</h3>
				<p>{AI_CONTRIBUTION.summary}</p>
				<ul>
					{AI_CONTRIBUTION.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<p class="muted">
					参与形式：<span class="egg-word" data-egg-word>{AI_CONTRIBUTION.assistant}</span>（模型 <span
						class="egg-word"
						data-egg-word>{AI_CONTRIBUTION.model}</span>），
					担任{AI_CONTRIBUTION.role}。{AI_CONTRIBUTION.disclaimer}
				</p>
			</div>
		</div>

		<div class="card reveal">
			<div class="row">
				<a class="btn" href={REPO_URL} target="_blank" rel="noopener noreferrer">查看源码仓库</a>
				<a class="btn btn--ghost" href={LICENSE.url} target="_blank" rel="noopener noreferrer">
					许可证全文
				</a>
			</div>
		</div>
	</section>

	<p class="muted about-foot">
		&copy; {copyrightYears} {SITE_AUTHOR} · 代码以 {LICENSE.shortName} 授权
	</p>

	<!--
		彩蛋：在上面两处带 data-egg-word 的字样上快速连点五次触发。
		图片是**本地文件**（public/easter-egg/），不经过任何第三方接口 ——
		与站内壁纸的自托管策略一致。
	-->
	<div class="ds-egg" id="dsEgg" hidden>
		<div class="ds-egg__logo" aria-hidden="true">
			<svg viewBox="0 0 64 44" fill="none" aria-hidden="true">
				<path
					d="M3 25c1-6 6-11 13-13 8-2 16-1 22 3 4-4 8-10 10-15 1-2 3-1 3 1 0 7-2 13-6 17 2 4 2 9 0 12-3 6-10 9-19 9-11 0-20-5-23-14Z"
					fill="currentColor"></path>
				<circle cx="19" cy="21" r="2.2" fill="#fff"></circle>
			</svg>
		</div>
		<img class="ds-egg__art" id="dsEggArt" src="/easter-egg/deepseek-whale.png" alt="DeepSeek 鲸鱼娘" />
	</div>
</BaseLayout>

<script>
	/*
	 * 彩蛋：在「DeepSeek Harness」「deepseek-flash」两处快速连点五次。
	 *
	 * 每点一次蓝色加深一档（0→5），两处共用一个计数；
	 * 两次点击间隔超过 RAPID_MS 就整个重置，所以必须"快速"点。
	 * 满五次后播一段入场：图标从点击位置移到屏幕中央并放大，随后放出图片。
	 *
	 * 图片是本地文件，不请求任何外部接口 —— 与站内壁纸的自托管策略一致。
	 */
	const RAPID_MS = 700;
	const NEEDED = 5;

	const egg = document.getElementById('dsEgg');
	const words = [...document.querySelectorAll('[data-egg-word]')];

	if (egg && words.length) {
		const art = document.getElementById('dsEggArt') as HTMLImageElement | null;
		let count = 0;
		let stepTimer = 0;
		/** 播放中不再接受点击，避免叠加播放 */
		let playing = false;

		const reset = () => {
			count = 0;
			for (const word of words) word.removeAttribute('data-egg-step');
		};

		const scheduleReset = () => {
			window.clearTimeout(stepTimer);
			stepTimer = window.setTimeout(reset, RAPID_MS);
		};

		const close = () => {
			egg.hidden = true;
			egg.classList.remove('is-logo', 'is-art');
			playing = false;
			document.body.style.overflow = '';
			reset();
		};

		const play = (x: number, y: number) => {
			playing = true;
			egg.hidden = false;
			document.body.style.overflow = 'hidden';

			// 图标从点击处飞到屏幕中心，因此先算相对中心的偏移
			egg.style.setProperty('--egg-dx', `${Math.round(x - window.innerWidth / 2)}px`);
			egg.style.setProperty('--egg-dy', `${Math.round(y - window.innerHeight / 2)}px`);
			egg.classList.add('is-logo');

			// 系统开了"减少动态效果"就直接出图，不播入场
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				egg.classList.add('is-art');
				return;
			}
			window.setTimeout(() => egg.classList.add('is-art'), 1150);
		};

		for (const word of words) {
			word.addEventListener('click', (event) => {
				if (playing) return;
				count += 1;
				for (const other of words) other.setAttribute('data-egg-step', String(count));
				scheduleReset();

				if (count >= NEEDED) {
					const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();
					play(rect.left + rect.width / 2, rect.top + rect.height / 2);
				}
			});
		}

		egg.addEventListener('click', close);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !egg.hidden) close();
		});

		// 图片缺失时给出提示，而不是留一片空白
		art?.addEventListener('error', () => art.classList.add('is-missing'));
	}
</script>

<style>
	.stack-list {
		margin: 0;
		display: grid;
		gap: 0.1rem;
	}

	.stack-list__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--stroke);
	}

	.stack-list__row:last-child {
		border-bottom: none;
	}

	.stack-list__row dt {
		min-width: 5.5rem;
		font-size: 0.85rem;
		color: var(--text-tertiary);
	}

	.stack-list__row dd {
		margin: 0;
		flex: 1;
		min-width: 12rem;
		color: var(--text-secondary);
		font-size: 0.92rem;
	}

	.contact__lead {
		margin: 0 0 1rem;
		font-size: 0.94rem;
	}

	.about-foot {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
		text-align: center;
	}

	/* -------------------------------------------------- 彩蛋 */
	.egg-word {
		cursor: default;
		transition: color 0.26s ease;
	}

	/* 每点一次加深一档，第五档落到 DeepSeek 的品牌蓝 */
	.egg-word[data-egg-step='1'] {
		color: #b7c3ff;
	}

	.egg-word[data-egg-step='2'] {
		color: #93a6ff;
	}

	.egg-word[data-egg-step='3'] {
		color: #748cff;
	}

	.egg-word[data-egg-step='4'] {
		color: #5c78fe;
	}

	.egg-word[data-egg-step='5'] {
		color: #4d6bfe;
	}

	.ds-egg {
		position: fixed;
		inset: 0;
		z-index: 120;
		background: rgba(6, 8, 14, 0.72);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		cursor: pointer;
	}

	.ds-egg[hidden] {
		display: none;
	}

	/*
	 * 用 transform 做位移而不是 left/top：
	 * 起点是点击处相对屏幕中心的偏移（--egg-dx/--egg-dy），终点归零即居中。
	 */
	.ds-egg__logo {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 92px;
		height: 63px;
		margin: -32px 0 0 -46px;
		color: #4d6bfe;
		opacity: 0;
		transform: translate(var(--egg-dx, 0px), var(--egg-dy, 0px)) scale(0.34);
		transition:
			transform 720ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 300ms ease;
	}

	.ds-egg.is-logo .ds-egg__logo {
		opacity: 1;
		transform: translate(0, 0) scale(1.55);
	}

	.ds-egg.is-art .ds-egg__logo {
		opacity: 0;
		transform: translate(0, 0) scale(2);
		transition:
			transform 420ms ease,
			opacity 380ms ease;
	}

	.ds-egg__art {
		position: absolute;
		left: 50%;
		top: 50%;
		max-width: min(88vw, 940px);
		max-height: 84vh;
		border-radius: 16px;
		box-shadow: 0 32px 90px rgba(0, 0, 0, 0.6);
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.7);
		transition:
			transform 520ms cubic-bezier(0.18, 1.24, 0.4, 1),
			opacity 320ms ease;
	}

	.ds-egg.is-art .ds-egg__art {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}

	/* 图片没放或取不到时的样子：至少让人知道该放哪 */
	.ds-egg__art.is-missing {
		width: min(80vw, 520px);
		height: auto;
		padding: 2rem;
		background: var(--surface-2);
		color: var(--text-secondary);
		font-size: 0.86rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.ds-egg__logo,
		.ds-egg__art {
			transition: none;
		}
	}
</style>
