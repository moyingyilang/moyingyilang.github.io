---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REPO_URL, SITE_AUTHOR, SITE_DESCRIPTION } from '../consts';

const AFDIAN_URL = 'https://ifdian.net/a/luyaoqisen6173';

const PROJECTS = [
	{
		name: 'JMNeXt',
		desc: 'Android / 桌面端第三方漫画客户端，Kotlin + Compose，数据层两端共用。',
		href: 'https://github.com/moyingyilang/JMNeXt',
	},
	{
		name: 'EFML4A',
		desc: 'Android 上的 Mod 加载与运行时实验项目。',
		href: 'https://github.com/moyingyilang/EFML4A',
	},
	{
		name: '个人文档站',
		desc: '技术笔记、开发环境与项目记录的长期归档。',
		href: REPO_URL,
	},
];
---

<BaseLayout title="赞助支持" description="支持路遥起森的开源项目与文档站维护。">
	<nav class="breadcrumbs" aria-label="面包屑">
		<a href="/">首页</a>
		<span class="sep" aria-hidden="true">/</span>
		<span aria-current="page">赞助支持</span>
	</nav>

	<div class="page-head">
		<span class="page-head__eyebrow badge">独立页面</span>
		<h1 class="page-title">赞助支持</h1>
		<p class="page-desc">如果这里的内容或项目对你有帮助，可以通过爱发电支持维护。</p>
	</div>

	<section class="card card--pad reveal">
		<div class="prose">
			<h2>这些支持会用在哪儿</h2>
			<p>
				主要覆盖服务器与对象存储、构建机与测试设备、签名与发布工具，以及持续维护文档和兼容性所需的时间。
				项目本身保持开源，赞助不会解锁额外功能。
			</p>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">维护中的项目</h2>
		<div class="grid grid--auto">
			{
				PROJECTS.map((project) => (
					<a class="card reveal" href={project.href} target="_blank" rel="noopener noreferrer">
						<span class="card__arrow">→</span>
						<h3 class="card__title">{project.name}</h3>
						<p class="card__desc">{project.desc}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">支持方式</h2>
		<div class="card card--pad reveal support-card">
			<div class="prose">
				<p>
					爱发电主页：<a href={AFDIAN_URL} target="_blank" rel="noopener noreferrer">{AFDIAN_URL}</a>
				</p>
				<p>扫码或打开上面的链接即可；金额随意，不设档位门槛。</p>
			</div>
			<div class="row support-actions">
				<a class="btn btn--accent" href={AFDIAN_URL} target="_blank" rel="noopener noreferrer">前往爱发电</a>
				<a class="btn btn--ghost" href="/about">了解本站</a>
			</div>
		</div>
	</section>

	<section class="stack">
		<h2 class="section-heading">说明</h2>
		<div class="card card--pad reveal">
			<div class="prose">
				<ul>
					<li>赞助完全自愿，不影响任何现有功能，也不代表购买付费服务或优先支持。</li>
					<li>不接受定制破解、盗版资源或任何侵犯第三方权利的内容。</li>
					<li>本站与 JMComic 官方及其他内容平台没有隶属关系；项目仅作为第三方客户端实现。</li>
					<li>代码与站主原创内容仍以 AGPL-3.0-only 授权，赞助不改变许可证条款。</li>
				</ul>
				<p class="muted">联系：GitHub <a href="https://github.com/moyingyilang" target="_blank" rel="noopener noreferrer">@moyingyilang</a></p>
			</div>
		</div>
	</section>

	<p class="muted support-foot">&copy; {new Date().getFullYear()} {SITE_AUTHOR} · 感谢每一份支持</p>
</BaseLayout>

<style>
	.support-actions {
		margin-top: 1.1rem;
	}

	.support-foot {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
	}
</style>
